# Copy this to .env and fill in real values before the demo.

# SQLite for local dev (default, zero setup):
DATABASE_URL=sqlite:///./metroscan.db

# Postgres once Dev5's schema/server is ready:
# DATABASE_URL=postgresql://user:password@localhost:5432/metroscan

# ⚠️  MUST change before demo — the app logs a loud warning if this is left as-is.
# Generate a real secret: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_BEFORE_DEMO
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap admin account — the ONLY way to get a first admin into the system.
# POST /auth/promote itself requires an existing admin token, so without this
# seed there is no way to ever promote anyone.
# On every startup the app auto-creates (or re-promotes) this account.
# After logging in as this account, use its token to POST /auth/promote to
# elevate real teammate accounts to supervisor or admin, then rotate this
# password (or replace it with a proper IdP).
ADMIN_EMAIL=admin@metroscan.local
ADMIN_PASSWORD=replace-with-a-real-password

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
