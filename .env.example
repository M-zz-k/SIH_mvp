# =============================================================================
# METROSCAN AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://metroscan:metroscan@localhost:5432/metroscan

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- File Storage ---
STORAGE_PATH=./uploads
REPORTS_PATH=./reports

# --- Backend ---
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# --- Frontend ---
VITE_API_URL=http://localhost:8000
